<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ADR segregação Decrypt/LowCodeRunner (2026-09-25) — DESVIO IMPORTANTE do que o ADR assumia no §1:

    O ADR partiu do achado de que CryptographySysMiddle.cs usa só RijndaelManaged gerenciado, sem
    P/Invoke/COM, e concluiu que "tecnicamente esse código poderia rodar em .NET moderno". Isso é
    FALSO para a chave/IV reais em uso aqui: a chave tem 96 bits e o IV tem 152 bits — tamanhos que
    não existem em AES (128/192/256 de chave, bloco fixo de 128). A partir do .NET Core/.NET 5+,
    `RijndaelManaged` deixou de ser a implementação "Rijndael real" (que aceita bloco/chave em
    incrementos de 32 bits, 128–256) e virou um shim fino sobre AES — só aceita os tamanhos padrão
    do AES. Confirmado empiricamente nesta etapa: rodando este mesmo código em net10.0, o
    CreateEncryptor/CreateDecryptor lança `ArgumentException: Specified key is not a valid size for
    this algorithm` para a chave/IV reais do projeto (teste que expôs isso removido do histórico de
    tentativa, mas o comportamento é reproduzível trocando o TargetFramework para net10.0).

    Migrar o algoritmo teria que passar por uma implementação alternativa (ex.: BouncyCastle
    RijndaelEngine, que aceita bloco/chave variável) com validação byte-a-byte contra a saída atual
    — isso é trabalho de validação não trivial, FORA do escopo desta etapa (é o candidato a ADR
    futuro já previsto no §5 do ADR original). Por isso esta etapa mantém a criptografia rodando em
    **.NET Framework 4.8.1** (TargetFramework net48, não net10.0) — só migra o TRANSPORTE de
    subprocess (Process.Start + arquivo temp) para um serviço HTTP auto-hospedado
    (System.Net.HttpListener, sem dependência de ASP.NET Core, que não roda em .NET Framework
    clássico). Fica documentado como pendência a reportar de volta ao autor do ADR (@lp-architect).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>LayoutParserDecrypt</RootNamespace>
    <AssemblyName>LayoutParserDecrypt</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
    <Content Remove="tests\**\*" />
    <None Remove="tests\**\*" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

</Project>
